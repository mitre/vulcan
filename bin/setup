#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  # .env holds the shared database settings; .env.development and .env.test
  # build on it (load order in .env.example). A .env from before the split
  # still holds the development settings, and a new .env.development would
  # override them, so it is not created next to one.
  single_file_env = File.exist?(".env") && !File.exist?(".env.development")
  %w[.env .env.development .env.test].each do |file|
    next if File.exist?(file)
    next if file == ".env.development" && single_file_env

    puts "== Copying #{file}.example to #{file} =="
    FileUtils.cp "#{file}.example", file
  end
  if single_file_env
    puts "   .env still holds the development settings; to split it, see docs/site/development/setup.md."
  end

  puts "\n== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Installing JavaScript dependencies =="
  system! "yarn install --immutable"

  puts "\n== Building JavaScript assets =="
  system! "yarn build"

  puts "\n== Starting development database =="
  system "docker compose -f docker-compose.dev.yml up db -d"

  # Wait for PostgreSQL to be ready
  pgport = ENV.fetch("DATABASE_PORT", "5432")
  pghost = ENV.fetch("DATABASE_HOST", "127.0.0.1")
  print "   Waiting for PostgreSQL on #{pghost}:#{pgport}"
  30.times do
    break if system("pg_isready -h #{pghost} -p #{pgport} -q 2>/dev/null")
    print "."
    sleep 1
  end
  puts

  puts "\n== Checking for legacy database names =="
  system "bin/db-rename-legacy"

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"

  puts "\n== Running upgrade checks =="
  system "bin/rails upgrade:auto"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
