# Vulcan base environment: settings shared by development and test
# Copy this file to .env and update with your values.
#
# Rails (dotenv-rails) loads, in priority order:
#   .env.<environment>.local, .env.local (not in test), .env.<environment>, .env
# The first file to set a variable wins, and a variable already set in the
# shell wins over every file. Docker Compose reads only .env.
#
#   .env              this file: database and ports, used everywhere
#   .env.development  development settings (copy .env.development.example)
#   .env.test         test suite settings (copy .env.test.example)
#
# For production Docker deployments, see .env.production.example

# =============================================================================
# DATABASE
# =============================================================================
# Defaults (port 5432, host 127.0.0.1) work for single-project development.
# Running multiple projects simultaneously? Assign unique ports per project.
# See docs/site/development/port-registry.md for recommended port assignments.
# Development and test share the server; the test database name is fixed
# (vulcan_test, plus a number per parallel process).
#
# DATABASE_PORT=5432
# DATABASE_HOST=127.0.0.1
# POSTGRES_PORT=5432
#
# macOS with Kerberos/GSSAPI connection errors (corporate networks):
# DATABASE_GSSENCMODE=disable
#
# App server port (Puma):
# PORT=3000

# Docker database password (used by docker-compose)
POSTGRES_PASSWORD=postgres
