{
  "name": "vulcan_vue",
  "private": true,
  "license": "Apache-2.0",
  "dependencies": {
    "@rails/actioncable": "^8.0.201",
    "@rails/activestorage": "^8.0.201",
    "@rails/ujs": "^7.1.3-4",
    "bootstrap": "4.6.2",
    "bootstrap-icons": "^1.13.1",
    "bootstrap-vue": "2.23.1",
    "dompurify": "^3.4.15",
    "easymde": "^2.20.0",
    "font-awesome": "^4.7.0",
    "jquery": "^3.7.1",
    "ky": "^2.0.2",
    "lodash": "^4.17.21",
    "marked": "^18.0.11",
    "moment": "^2.29.4",
    "monaco-editor": "0.57.0",
    "pinia": "^2",
    "popper.js": "^1.16.1",
    "shiki": "^4.5.0",
    "v-linkify": "^1.0.12",
    "vue": "~2.7.16",
    "vue-highlight-words": "1.2.0",
    "vue-loader": "^15.10.0",
    "vue-multiselect": "^2.1.9",
    "vue-router": "3",
    "vue-template-compiler": "~2.7.16"
  },
  "version": "2.4.2",
  "devDependencies": {
    "@pinia/testing": "^2.0.1",
    "@redocly/cli": "^2.47.0",
    "@vitejs/plugin-vue2": "^2.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "esbuild-sass-plugin": "^3.3.1",
    "esbuild-vue": "^1.2.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "sass": "^1.85.1",
    "vite": "^7.3.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "scripts": {
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "eslint --fix app/javascript spec/javascript",
    "lint:ci": "eslint --max-warnings 0 app/javascript spec/javascript",
    "build": "node esbuild.config.js",
    "build:clean": "rm -rf app/assets/builds/*.js app/assets/builds/*.css && node esbuild.config.js",
    "build:css": "sass ./app/javascript/application.scss:./app/assets/builds/application.css --load-path=node_modules",
    "build:watch": "chokidar 'app/javascript/**/*' -c 'yarn build'",
    "dev": "concurrently \"rails server\" \"yarn build:watch\"",
    "openapi:bundle": "redocly bundle doc/openapi/openapi.yaml -o doc/openapi.yaml",
    "openapi:docs": "redocly bundle doc/openapi/openapi.yaml -o docs/site/data/openapi.json --ext json && mkdir -p docs/site/public/api && cp docs/site/data/openapi.json docs/site/public/api/openapi.json && cp doc/openapi.yaml docs/site/public/api/openapi.yaml",
    "openapi:lint": "redocly lint doc/openapi/openapi.yaml",
    "docs:dev": "cd docs && yarn install --immutable && yarn dev",
    "docs:build": "cd docs && yarn install --immutable && yarn build",
    "docs:preview": "cd docs && yarn install --immutable && yarn preview"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "loader-utils": ">=1.4.1",
    "json5": ">=1.0.2",
    "postcss": ">=8.4.31",
    "brace-expansion": ">=1.1.12",
    "vite": "^7.3.6",
    "flatted": "^3.4.2",
    "ws": "^8.21.0",
    "rollup": "^4.59.0",
    "piscina": "^4.9.3",
    "lodash": "^4.18.1",
    "js-cookie": "^3.0.7",
    "chokidar/picomatch": "^2.3.2",
    "anymatch/picomatch": "^2.3.2"
  },
  "dependenciesMeta": {
    "vue-demi": {
      "built": true
    }
  }
}
