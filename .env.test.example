# Vulcan test environment: loaded by the test suite (RAILS_ENV=test)
# Copy this file to .env.test. Database settings come from .env.
#
# This mirrors the env block of the backend job in .github/workflows/ci.yml.
# Leave every other setting unset: the specs expect the application defaults,
# and .env.local is not loaded in test, so personal overrides stay out.

# =============================================================================
# OIDC
# =============================================================================
# The request specs sign in through OmniAuth test mode with outbound HTTP
# blocked (WebMock), so this placeholder issuer is enough to register the
# provider. The .invalid domain never resolves, so the live discovery specs in
# spec/system/okta_discovery_integration_spec.rb skip. To run them, set the
# issuer, client ID and secret of a test OIDC application.
VULCAN_ENABLE_OIDC=true
VULCAN_OIDC_DISCOVERY=true
VULCAN_OIDC_ISSUER_URL=https://idp.invalid
VULCAN_OIDC_CLIENT_ID=your_oidc_client_id
VULCAN_OIDC_CLIENT_SECRET=your_oidc_client_secret

# =============================================================================
# LDAP (optional)
# =============================================================================
# The LDAP login specs run when LDAP is enabled and need a running server.
# CI uses the rroemhild/test-openldap image with its public defaults:
#   docker run -d -p 10389:10389 rroemhild/test-openldap
# VULCAN_ENABLE_LDAP=true
# VULCAN_LDAP_HOST=localhost
# VULCAN_LDAP_PORT=10389
# VULCAN_LDAP_ATTRIBUTE=mail
# VULCAN_LDAP_BASE=ou=people,dc=planetexpress,dc=com
# VULCAN_LDAP_BIND_DN=cn=admin,dc=planetexpress,dc=com
# VULCAN_LDAP_ADMIN_PASS=GoodNewsEveryone
